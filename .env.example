# Supabase project (Settings → API). The anon/publishable key is safe to ship
# to browsers – all data access is enforced by Row Level Security.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: Web Push (VAPID public key). Leave empty to disable push sign-up.
VITE_VAPID_PUBLIC_KEY=
