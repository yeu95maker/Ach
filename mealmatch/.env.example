# Copy to .env.local (git-ignored) and restart `npx expo start`.

# TheMealDB – "1" is the free test key for development.
# For a public app-store release, become a supporter at themealdb.com and put your key here.
EXPO_PUBLIC_MEALDB_API_KEY=1
# EXPO_PUBLIC_MEALDB_ENABLED=false

# Spoonacular – adds recipes with full nutrition. Get a key at https://spoonacular.com/food-api
# EXPO_PUBLIC_SPOONACULAR_API_KEY=your-key-here
# How many to download per refresh (each 100 ≈ 7 API points; free tier ≈ 50 points/day)
# EXPO_PUBLIC_SPOONACULAR_MAX_RECIPES=300

# Re-download provider recipes after this many hours
# EXPO_PUBLIC_RECIPE_CACHE_HOURS=72
