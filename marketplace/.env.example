# Supabase project (Settings → API). The anon/publishable key is safe in the
# browser – all data access is enforced by Row Level Security and the API functions.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Mapbox access token (public, URL-restricted token). Without it the map falls
# back to OpenStreetMap tiles, which is fine for local development only.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Billing: "demo" (premium activates without payment – also needs
# app_settings.demo_billing = true in the database) or "none" (upgrade button
# shows "coming soon"). A real provider is plugged in via src/lib/billing.
BILLING_PROVIDER=demo

# Server only – used by payment webhooks (src/app/api/billing/webhook). Never expose.
SUPABASE_SERVICE_ROLE_KEY=
