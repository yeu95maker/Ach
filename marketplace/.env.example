# Supabase project (Settings → API). The anon/publishable key is safe in the
# browser – all data access is enforced by Row Level Security and the API functions.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only – used for payments (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app – Paynow sends customers back here and posts payment results to
# <APP_URL>/api/billing/paynow/result, so it must be reachable from the internet.
APP_URL=http://localhost:3000

# Mapbox access token (public, URL-restricted). Without it the map uses OpenStreetMap tiles (dev only).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Billing: "paynow" (real payments), "demo" (Premium without payment – also needs
# app_settings.demo_billing = true; never in production) or "none".
BILLING_PROVIDER=paynow

# Paynow (https://www.paynow.co.zw → Receive Payments → integration for USD).
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# While the integration is in Paynow test mode, mobile payments only work with the
# merchant account's own email – put it here, and remove it when going live.
PAYNOW_TEST_AUTH_EMAIL=
# Only for automated tests against scripts/e2e/paynow-mock.mjs
# PAYNOW_BASE_URL=http://localhost:4010

# Email notifications (src/app/api/cron/emails): "resend" in production, "log" in development.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="StandFinder <hello@example.com>"
# Protects the cron endpoints (Vercel sends it automatically as Bearer token).
CRON_SECRET=

# Operator details for /privacy, /terms, /imprint and /support (required by the app stores).
LEGAL_NAME=
LEGAL_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Native apps (docs/APP-STORES.md): universal links (iOS) and app links (Android).
APPLE_TEAM_ID=
# SHA-256 of the Play app signing key, comma-separated if several.
ANDROID_CERT_SHA256=
