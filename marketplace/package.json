{
  "name": "property-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile-first property marketplace \u2013 houses, apartments, land and commercial property from verified providers",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "./scripts/db-test.sh",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e:gateway": "node scripts/e2e/gateway.mjs",
    "e2e": "node scripts/e2e/journeys.mjs",
    "mobile:sync": "node scripts/mobile/configure.mjs && cap sync",
    "mobile:assets": "npx --yes @capacitor/assets@3.0.5 generate --assetPath mobile/assets --iconBackgroundColor \"#12805e\" --splashBackgroundColor \"#12805e\" --ios --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.14.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
